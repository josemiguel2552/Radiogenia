# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Admin emails (comma-separated)
ADMIN_EMAILS=your_admin_email@example.com

# Encryption key for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_256_bit_hex_key

# Deepgram (streaming voice dictation — optional, falls back to Whisper)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Radiogen.AI <noreply@radiogen.ai>
EMAIL_REPLY_TO=info@radiogen.ai
NEXT_PUBLIC_APP_URL=https://radiogen.ai

# Cron secret — protects scheduled routes (e.g. the 24h onboarding email).
# Generate with: openssl rand -hex 32. Set the SAME value in Vercel so its Cron
# invocations are authorized (Vercel sends it as `Authorization: Bearer <secret>`).
CRON_SECRET=your_cron_secret
